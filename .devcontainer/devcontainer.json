{
  "name": "PySide6 + Claude Code (sandboxed)",
  "build": { "dockerfile": "Dockerfile" },

  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  // NET_ADMIN / NET_RAW はコンテナ内のファイアウォール（iptables）用
  // --userns=keep-id は rootless Podman でワークスペースの所有者を揃えるため
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],
  "remoteUser": "vscode",
  "updateRemoteUserUID": false,

  // Claude と gh の認証情報はホストではなくボリュームに保存（リビルドしても残る）
  "mounts": [
    "source=claude-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=gh-config-${devcontainerId},target=/home/vscode/.config/gh,type=volume"
  ],

  "containerEnv": {
    "DISABLE_AUTOUPDATER": "1",
    "UV_LINK_MODE": "copy",
    "QT_QPA_PLATFORM": "xcb"
  },

  // 依存のインストール → その後にファイアウォールを有効化
  "postCreateCommand": "uv sync",
  "postStartCommand": "sudo /usr/local/bin/gui-app-firewall.sh",
  "waitFor": "postStartCommand",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "anthropic.claude-code"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
